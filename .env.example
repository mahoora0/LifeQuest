MYSQL_DATABASE=lifequest
MYSQL_USER=lifequest
MYSQL_PASSWORD=lifequest-local
MYSQL_ROOT_PASSWORD=lifequest-root-local

DB_URL=jdbc:mysql://localhost:3306/lifequest?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
DB_USERNAME=lifequest
DB_PASSWORD=lifequest-local

# At least 32 characters. Replace this value outside local development.
JWT_SECRET=change-this-local-jwt-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_SECONDS=900
JWT_REFRESH_TOKEN_SECONDS=1209600
# Google Cloud Console에서 만든 "웹 애플리케이션" OAuth 클라이언트 ID.
# Flutter와 백엔드가 같은 값을 사용해야 ID 토큰의 audience를 검증할 수 있습니다.
GOOGLE_CLIENT_ID=

# Wi-Fi/LAN으로 연결한 실기기에서만 PC의 LAN IP로 설정합니다.
# Android 에뮬레이터와 USB 연결은 비워 두어도 됩니다.
FLUTTER_API_BASE_URL=

# 여러 모바일 기기가 연결될 때 이 PC에서 기본으로 실행할 flutter devices ID.
FLUTTER_DEVICE_ID=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
